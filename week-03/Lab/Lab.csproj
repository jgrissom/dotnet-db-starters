<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Your first NuGet package. Nobody installed this on your machine, and
       nobody has to: the line below is part of the PROJECT, so `dotnet build`
       fetches it the first time and every machine that ever opens this folder
       gets the same version. That's what "restore" means. -->
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
